# Copy this file to .env and fill in what you have. Everything except the keys has a sensible default.
# The real environment wins over this file, so you can also `export` any of these.

# --- Meta Model API (Muse Spark writes the alerts, Muse Voice Transcribe hears voice notes) -----
# Without a key, Uplink still works and sends its hand-written templates.
MODEL_API_KEY=
# MODEL_NAME=muse-spark-1.3
# MODEL_REASONING_EFFORT=low          # minimal | low | medium | high | xhigh

# --- WhatsApp Cloud API (see docs/WHATSAPP_SETUP.md) ------------------------------------------
WHATSAPP_TOKEN=                       # access token from API Setup (temporary ones last 24 hours)
WHATSAPP_PHONE_NUMBER_ID=             # the phone number ID shown under API Setup, not the number itself
WHATSAPP_TO=                          # your own WhatsApp number with country code, e.g. 14155550123
WHATSAPP_APP_SECRET=                  # App settings > Basic > App secret (checks webhook signatures)
WHATSAPP_VERIFY_TOKEN=                # any phrase you choose; type the same one in the webhook settings
# WHATSAPP_API_VERSION=v26.0
# WHATSAPP_ALERT_TEMPLATE=            # an approved template with one body variable, to alert outside the 24-hour window

# --- The network -----------------------------------------------------------------------------
# FEED_URL=https://map.ffmuc.net/data/meshviewer.json
# NETWORK_NAME=Freifunk München
LANGUAGE=english                      # english | telugu | hindi
ANONYMIZE=false                       # true replaces router names with short ids (use it for public demos)
# WATCH_NODES=                        # node ids or names that should alert even when they fail alone
# CONTACT=                            # your email, added to the User-Agent so the map's admins can reach you

# --- When to send a message --------------------------------------------------------------------
# ALERT_MIN_NODES=2                   # nodes that must fail together
# ALERT_MIN_USERS=15                  # ...or people who must lose their connection
# CONFIRM_SECONDS=60                  # an outage must still be there one poll later
# ALERTS_PER_HOUR=6

# --- Running ----------------------------------------------------------------------------------
# DATA_DIR=data
# RECORD_SNAPSHOTS=true               # keeps one compact snapshot per minute (about 6 MB a day) for `uplink replay`
# POLL_INTERVAL_SECONDS=60            # never faster than 60 for a public map
# STALE_AFTER_SECONDS=180             # a node silent this long counts as down, before the map notices
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8080
# FFMPEG_PATH=ffmpeg
